# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
APP_URL=http://localhost:4000

# Must match the API's MONGODB_URI — same Atlas cluster.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/smm_panel
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Leave unset in development to disable remote license validation
# LICENSE_SERVER_URL=https://license.example.com
LICENSE_SHARED_SECRET=dev-license-shared-secret
INSTALLATION_ID=dev-installation
LOG_LEVEL=info
