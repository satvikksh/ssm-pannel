# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# API port. User panel sits in front on port 3000, admin on 3001.
PORT=4000
APP_URL=http://localhost:4000

# Comma-separated additional browser origins allowed by CORS.
# The user panel (3000) and admin panel (3001) are always allowed by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/smm_panel
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=change-me

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Super Admin bootstrap (server-side only, never exposed to the frontends) ──
# PLACEHOLDERS — replace with real values in your actual .env.
# `npm run seed -w @smm/api` reads these to create the Super Admin in the
# `users` collection with role `super_admin` when the account does not exist.
# Existing accounts are never overwritten. Do NOT hardcode real credentials.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
